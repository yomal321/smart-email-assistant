        <mxCell id="title" value="Smart Email Assistant &#8212; C4 Level 3b: Components of the Web Dashboard (Next.js)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0B4884;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Exactly one write path &#8212; the draft request &#8212; and it goes to n8n, not the database. Everything else is a read." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
