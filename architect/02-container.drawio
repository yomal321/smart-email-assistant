        </mxCell>

        <mxCell id="db" value="&lt;b&gt;Database&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Container: Supabase / PostgreSQL]&lt;/i&gt;&lt;br&gt;&lt;br&gt;accounts &#183; emails &#183; tasks&lt;br&gt;full-text search via tsvector" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
