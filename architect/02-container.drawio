        <mxCell id="web" value="&lt;b&gt;Web Dashboard&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Container: Next.js App Router + TypeScript, on Vercel]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Unified inbox, action-item sidebar,&lt;br&gt;draft review modal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;arcSize=12;" vertex="1" parent="1">
