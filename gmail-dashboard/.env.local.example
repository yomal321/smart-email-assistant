# Copy this file to .env.local and fill in real values.
# .env.local is already gitignored — never commit real secrets.

# Supabase project URL (Project Settings -> API -> Project URL). Read by
# lib/supabase/server.ts; server-only, never sent to the browser.
SUPABASE_URL=https://your-project.supabase.co

# Supabase service-role key (Project Settings -> API -> service_role secret).
# Server-only (enforced by the `server-only` import in lib/supabase/server.ts)
# — this key must never reach a client bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Random secret used to sign/verify the session cookie via crypto.subtle
# HMAC-SHA256 (lib/auth/session.ts). Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-random-32-byte-secret

# The single operator's login password, checked by POST /api/auth/login
# (constant-time comparison). An env var, not a database row.
DASHBOARD_LOGIN_SECRET=replace-with-a-strong-password

# n8n's generate-draft webhook URL, called server-side by POST /api/drafts
# (this dashboard never talks to n8n from the browser).
N8N_DRAFT_WEBHOOK_URL=https://your-n8n-instance/webhook/generate-draft

# Must match the n8n environment variable of the same name
# (n8n/workflows/draft-generation.json's "Verify secret" node) exactly --
# these are two independent copies of one secret, with no shared credential
# store between the two services. Rotate both together.
DRAFT_WEBHOOK_SECRET=replace-with-the-same-value-as-n8n's-DRAFT_WEBHOOK_SECRET
